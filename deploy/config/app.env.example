# Replace with your own ACME email before production use.
PROJECT_NAME=FGFW
PROJECT_NAMESPACE=fgfw
PROJECT_REPO_URL=https://github.com/tuturuning/FGFW
RUNTIME_DIR=/opt/myproxy
CONFIG_DIR=/opt/myproxy/config
OUTPUT_DIR=/opt/myproxy/output
BACKUP_DIR=/opt/myproxy/backups
LOG_DIR=/opt/myproxy/logs

XRAY_VERSION=latest
SINGBOX_VERSION=latest
CLOUDFLARED_VERSION=latest

DEFAULT_TARGET=demo-sg
DEFAULT_NODE_GROUP=default

ENABLE_IPV4=true
ENABLE_IPV6=true
DEFAULT_STACK=dual

ENABLE_ARGO=false
ENABLE_WARP=false
ENABLE_ACME=true

CERT_MODE=acme
CERT_DIR=/opt/myproxy/certs
ACME_PROVIDER=letsencrypt
ACME_EMAIL=admin@example.com

DEFAULT_EXPORT_FORMATS=links,v2rayn,shadowrocket,clash
DEFAULT_EXPORT_GROUP=default
EXTERNAL_SUB_URL=https://worker.example/sub?group=default
